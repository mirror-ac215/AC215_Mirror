# GCS source used only when the service starts in real mode.
MODEL_BUCKET=mirror-ac215-data
MODEL_OBJECT=models/cv/inherited-v3/vit_b16_v3_best.pth
MODEL_VERSION=cv-vit-b16-v3
# Optional: path to a text object naming the version Mostafa has approved for
# serving. When set, /health reports this value instead of MODEL_VERSION. It
# never changes MODEL_OBJECT; Owen still configures which artifact loads.
MODEL_VERSION_TAG_OBJECT=
UNCERTAIN_MARGIN=0.1
MAX_BATCH_SIZE=8
# Writable in-container cache directory; never point this inside the repository.
MODEL_CACHE_DIR=/tmp/mirror-cv-model
