# GCS source used only when the service starts in real mode.
MODEL_BUCKET=mirror-ac215-data
MODEL_OBJECT=models/cv/v4/vit_b16_v4.pth
MODEL_VERSION=cv-vit-b16-v4
UNCERTAIN_MARGIN=0.1
MAX_BATCH_SIZE=8
# Writable in-container cache directory; never point this inside the repository.
MODEL_CACHE_DIR=/tmp/mirror-cv-model
