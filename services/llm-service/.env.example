# Laptop/CI mode. The default Docker build is the portable mock target.
MOCK_MODE=1
PORT=8002
LOG_LEVEL=INFO

# Real GPU mode. Do not put credentials, model weights, or downloaded artifacts here.
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
SERVED_MODEL_NAME=mirror-persona-v1
LORA_ADAPTER_PATH=/models/adapter-v1
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=1
# Adapter rank 32 requires an explicit vLLM allowance. Lower GPU-memory use is useful on display-attached GPUs.
MAX_LORA_RANK=32
GPU_MEMORY_UTILIZATION=0.9
# Keep auto by default; use half for a compatible T4 deployment after its smoke test.
DTYPE=auto
