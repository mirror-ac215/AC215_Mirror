# Optional. The local stack starts without this file: infra/compose.yml has
# local-only defaults for every value below. To override any of them, copy this
# file to infra/.env (never committed) and set only the lines you need.
# Production does not use this file; see infra/.env.prod.example.
DB_NAME=
DB_USER=
DB_PASSWORD=
MIRROR_DEMO_PASSWORD=
# At least 32 random characters. Used only by api-gateway, never commit it.
JWT_SIGNING_KEY=
# Access-token lifetime in minutes (1-60).
JWT_EXPIRES_MINUTES=30
# JSON array of Caddy's fixed IP/CIDR(s), for example ["172.20.0.0/16"].
# Leave empty to reject X-Forwarded-For from all peers.
TRUSTED_PROXY_IPS=[]
