# Copy outside Git to infra/.env.prod on the VM. Keep the real file mode 0600.
# All values below are intentionally blank; do not commit a filled file.
POSTGRES_PASSWORD=
MIRROR_DEMO_PASSWORD=

# Team-access hostname resolved to the VM's reserved static IP by approved clients.
CADDY_DOMAIN=

# Host directory containing the downloaded LoRA adapter. It is mounted read-only.
LLM_ADAPTER_HOST_PATH=
LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
LLM_SERVED_MODEL_NAME=mirror-persona-v1
LLM_MAX_LORA_RANK=32
LLM_GPU_MEMORY_UTILIZATION=0.9
LLM_DTYPE=auto
LLM_MAX_MODEL_LEN=2048
LLM_MAX_NUM_SEQS=1

# M3-14 immutable Artifact Registry image coordinates. Set these on the VM only.
# MIRROR_IMAGE_TAG must be the 40-character Git SHA published by the main-only workflow.
MIRROR_IMAGE_REGISTRY=
MIRROR_IMAGE_REPOSITORY=
MIRROR_IMAGE_TAG=

# Leave CV disabled until its production artifact/identity path is approved.
# Never put a service-account key, token, or model artifact path in Git.
